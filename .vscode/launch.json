{
  "version": "0.2.0",
  "configurations": [
  
    {
      "name": "Player labeling (YOLO)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scoutiq/src/player_labeling.py",
      "args": [
        "data/input_videos/caitlin_clark_clip.mp4"
      ],
      "cwd": "${workspaceFolder}/scoutiq",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Process sample WNBA clip",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scoutiq/src/process_video.py",
      "args": [
        "data/input_videos/sample_wnba_clip.mp4"
      ],
      "cwd": "${workspaceFolder}/scoutiq",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Video Intake Filter (Desktop GUI)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scoutiq/app/video_intake_gui.py",
      "python": "${workspaceFolder}/scoutiq/.venv-gui/Scripts/python.exe",
      "cwd": "${workspaceFolder}/scoutiq",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Video Intake Filter (Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "app/video_upload_filter.py"
      ],
      "python": "${workspaceFolder}/scoutiq/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}/scoutiq",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Process video (pick file)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scoutiq/src/process_video.py",
      "args": [
        "${input:videoPath}"
      ],
      "cwd": "${workspaceFolder}/scoutiq",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "videoPath",
      "type": "promptString",
      "description": "Path to MP4 (relative to scoutiq/, e.g. data/input_videos/my_clip.mp4)",
      "default": "data/input_videos/sample_wnba_clip.mp4"
    }
  ]
}
